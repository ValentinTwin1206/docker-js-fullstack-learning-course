{
  "name": "Fancy FileServer DevContainer",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev_container",
  "workspaceFolder": "/workspace",
  "runServices": [
    "app",
    "frontend",
    "dev_container",
    "mongo",
    "redis"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "GitHub.copilot-chat"
      ]
    }
  },
   "forwardPorts": [
    9323,
    5173
  ],
  "portsAttributes": {
    "9323": {
      "label": "Metrics Port",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "React Dev Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "rm -rf node_modules && bun install && cd backend && rm -rf node_modules && bun install && cd ../frontend && rm -rf node_modules && bun install",
  "remoteUser": "node",
  "overrideCommand": false
}