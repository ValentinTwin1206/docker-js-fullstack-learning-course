APIKEY_JWT_SECRET={REPLACE_WITH_YOUR_CUSTOM_JWT_SECRET}
COOKIE_SECRET={REPLACE_WITH_YOUR_CUSTOM_COOKIE_SECRET}
COUNT_FILES=300
COUNT_USERS=300
IS_PROD=false
REDIS_URL=redis://redis:6379
LOG_LEVEL=debug
MONGO_URI=mongodb://mongo:27017/mydb
SALT_ROUNDS=10
SERVER_NAME=FancyFileServer
SERVER_URL=http://app
SERVER_PORT=3000
SYS_USER_FIRST=System
SYS_USER_LAST=Admin
SYS_USER_MAIL=sysuser@FancyFileServer.com
SYS_USER_PASS={REPLACE_WITH_YOUR_CUSTOM_SYS_PASSWORD}
SYS_USER_USERNAME={REPLACE_WITH_YOUR_CUSTOM_SYS_USERNAME}
TEST_RESULTS_DIR=.test
TEST_ROOT_DIR=./tests
TEST_USER_FIRST=Test
TEST_USER_LAST=User
