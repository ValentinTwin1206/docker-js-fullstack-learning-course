SYS_USER_FIRST={REPLACE_WITH_SYS_FIRSTNAME}
SYS_USER_LAST={REPLACE_WITH_SYS_LASTNAME}
SYS_USER_MAIL={REPLACE_WITH_SYS_EMAIL}
SYS_USER_PASS={REPLACE_WITH_SYS_PASSWORD}
SYS_USER_USERNAME={REPLACE_WITH_SYS_USERNAME}
TEST_RESULTS_DIR=.test
TEST_ROOT_DIR=./tests
TEST_USER_FIRST=Test
TEST_USER_LAST=User
