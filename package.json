{
  "name": "fancy-file-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:api": "bats tests/e2e/api --formatter tap --verbose-run",
    "test:gui": "bunx playwright test",
    "test:load:smoke:api": "bunx artillery run tests/load/api/smoke.yml --config tests/load/api/api-flows.yml",
    "test:load:smoke:gui": "bunx artillery run tests/load/gui/smoke.yml --config tests/load/gui/gui-flows.yml",
    "test:load:spike:api": "bunx artillery run tests/load/api/spike.yml --config tests/load/api/api-flows.yml",
    "test:load:spike:gui": "bunx artillery run tests/load/gui/spike.yml --config tests/load/gui/gui-flows.yml",
    "test:load:soak:api": "bunx artillery run tests/load/api/soak.yml --config tests/load/api/api-flows.yml",
    "test:load:soak:gui": "bunx artillery run tests/load/gui/soak.yml --config tests/load/gui/gui-flows.yml"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "artillery": "^2.0.28",
    "bun-types": "^1.3.0",
    "jose": "^5.2.3",
    "playwright": "^1.58.0"
  }
}
