{{!< layout}}
{{> _navbar isAdmin=true isAdminView=true}}

<div class="d-flex">
  {{> _sidemenu}}
  
  <div class="flex-grow-1 p-4">
    <h4 class="mb-4">User Growth Statistics</h4>

    <!-- Summary Cards - Total -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card" style="background-color: #d4edda;">
          <div class="card-body">
            <h5 class="card-title">Total Registrations</h5>
            <h2 id="totalRegistrations">0</h2>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card" style="background-color: #ffeceb;">
          <div class="card-body">
            <h5 class="card-title">Total Deletions</h5>
            <h2 id="totalDeletions">0</h2>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card" id="totalNetGrowthCard">
          <div class="card-body">
            <h5 class="card-title">Net Growth</h5>
            <h2 id="netGrowth">0</h2>
          </div>
        </div>
      </div>
    </div>

    <!-- Today's Stats -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title">Today's Registrations</h6>
            <h3 id="todayRegistrations">0</h3>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title">Today's Deletions</h6>
            <h3 id="todayDeletions">0</h3>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title">Today's Net Growth</h6>
            <h3 id="todayNetGrowth">0</h3>
            <small id="todayNetGrowthChange" class="text-muted"></small>
          </div>
        </div>
      </div>
    </div>

    <!-- Chart -->
    <div class="card mb-4">
      <div class="card-body">
        <h6 class="card-title">User Growth Over Time (Last 30 Days)</h6>
        <canvas id="growthChart" style="max-height: 400px;"></canvas>
      </div>
    </div>

    <!-- API Statistics Section -->
    <h4 class="mb-4 mt-5">API Statistics</h4>

    <!-- API Summary Cards - Total -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card" style="background-color: #e9f2ff;">
          <div class="card-body">
            <h5 class="card-title">Total Requests</h5>
            <h2 id="totalRequests">0</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card" style="background-color: #d4edda;">
          <div class="card-body">
            <h5 class="card-title">Success Rate</h5>
            <h2 id="successRate">0%</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card" style="background-color: #fff3cd;">
          <div class="card-body">
            <h5 class="card-title">Avg Response Time</h5>
            <h2 id="avgResponseTime">0ms</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card" style="background-color: #ffeceb;">
          <div class="card-body">
            <h5 class="card-title">Total Errors</h5>
            <h2 id="totalErrors">0</h2>
          </div>
        </div>
      </div>
    </div>

    <!-- Today's API Stats -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title">Today's Requests</h6>
            <h3 id="todayRequests">0</h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title">Today's Success Rate</h6>
            <h3 id="todaySuccessRate">0%</h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title">Today's Avg Latency</h6>
            <h3 id="todayAvgLatency">0ms</h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title">Today's Errors</h6>
            <h3 id="todayErrors">0</h3>
          </div>
        </div>
      </div>
    </div>

    <!-- API Charts -->
    <div class="row mb-4">
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <h6 class="card-title">Request Volume Over Time</h6>
            <canvas id="requestsChart" style="max-height: 300px;"></canvas>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <h6 class="card-title">Response Time Trends</h6>
            <canvas id="latencyChart" style="max-height: 300px;"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Routes Table -->
    <div class="card mb-4">
      <div class="card-body">
        <h6 class="card-title">Top 10 Most Called Routes</h6>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Method</th>
                <th>Path</th>
                <th>Total Requests</th>
                <th>Avg Latency</th>
              </tr>
            </thead>
            <tbody id="topRoutesTable">
              <tr>
                <td colspan="5" class="text-center text-muted">No data available</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Parse growth data from server
const growthData = {{{growthData}}};
const changeData = {{{changeData}}};
const apiStatsData = {{{apiStatsData}}};

document.addEventListener("DOMContentLoaded", () => {
  const ctx = document.getElementById('growthChart');

  // Format date for display
  function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { 
      month: 'short', 
      day: 'numeric' 
    });
  }

  // Update summary cards
  if (growthData.summary) {
    document.getElementById("totalRegistrations").textContent = growthData.summary.totalRegistrations || 0;
    document.getElementById("totalDeletions").textContent = growthData.summary.totalDeletions || 0;
    
    const totalNetGrowth = growthData.summary.netGrowth || 0;
    document.getElementById("netGrowth").textContent = totalNetGrowth;
    
    // Set background color based on net growth
    const totalNetGrowthCard = document.getElementById("totalNetGrowthCard");
    totalNetGrowthCard.style.backgroundColor = totalNetGrowth >= 0 ? '#e9f2ff' : '#ffeceb';
  }

  // Update today's stats (last day in the data)
  if (growthData.dailyData && growthData.dailyData.length > 0) {
    const today = growthData.dailyData[growthData.dailyData.length - 1];
    
    document.getElementById("todayRegistrations").textContent = today.registrations || 0;
    document.getElementById("todayDeletions").textContent = today.deletions || 0;
    document.getElementById("todayNetGrowth").textContent = today.netGrowth || 0;
    
    // Display percentage change for today's net growth
    if (changeData && changeData.percentage !== undefined) {
      const todayNetGrowthChangeElement = document.getElementById("todayNetGrowthChange");
      const sign = changeData.isPositive ? '+' : '';
      const color = changeData.isPositive ? 'green' : 'red';
      
      if (changeData.change !== 0) {
        todayNetGrowthChangeElement.textContent = `${sign}${changeData.percentage}% vs yesterday`;
        todayNetGrowthChangeElement.style.color = color;
      } else {
        todayNetGrowthChangeElement.textContent = 'No change vs yesterday';
        todayNetGrowthChangeElement.style.color = '#6c757d';
      }
    }
  }

  // Prepare data for chart
  const labels = [];
  const registrationsData = [];
  const deletionsData = [];
  const netGrowthData = [];
  let cumulativeUsers = 0;
  const cumulativeUsersData = [];

  if (growthData.dailyData && growthData.dailyData.length > 0) {
    // Populate chart data
    growthData.dailyData.forEach(day => {
      const dateLabel = formatDate(day.date);
      labels.push(dateLabel);
      registrationsData.push(day.registrations || 0);
      deletionsData.push(day.deletions || 0);
      netGrowthData.push(day.netGrowth || 0);
      
      // Calculate cumulative user count
      cumulativeUsers += (day.netGrowth || 0);
      cumulativeUsersData.push(cumulativeUsers);
    });

    // Create chart
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Total Users (Cumulative)',
            data: cumulativeUsersData,
            borderColor: 'rgb(0, 102, 255)',
            backgroundColor: 'rgba(0, 102, 255, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            yAxisID: 'y'
          },
          {
            label: 'Daily Registrations',
            data: registrationsData,
            borderColor: 'rgb(40, 167, 69)',
            backgroundColor: 'rgba(40, 167, 69, 0.1)',
            borderWidth: 2,
            tension: 0.3,
            yAxisID: 'y1'
          },
          {
            label: 'Daily Deletions',
            data: deletionsData,
            borderColor: 'rgb(220, 53, 69)',
            backgroundColor: 'rgba(220, 53, 69, 0.1)',
            borderWidth: 2,
            tension: 0.3,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        plugins: {
          legend: {
            position: 'top',
          },
          title: {
            display: false
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                let label = context.dataset.label || '';
                if (label) {
                  label += ': ';
                }
                label += context.parsed.y;
                return label;
              }
            }
          }
        },
        scales: {
          y: {
            type: 'linear',
            display: true,
            position: 'left',
            title: {
              display: true,
              text: 'Total Users'
            },
            beginAtZero: true
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            title: {
              display: true,
              text: 'Daily Changes'
            },
            beginAtZero: true,
            grid: {
              drawOnChartArea: false,
            },
          },
        }
      }
    });
  }

  // ========== API STATISTICS SECTION ==========
  
  // Update API summary cards
  if (apiStatsData.summary) {
    document.getElementById("totalRequests").textContent = apiStatsData.summary.totalRequests?.toLocaleString() || 0;
    document.getElementById("totalErrors").textContent = apiStatsData.summary.totalErrors?.toLocaleString() || 0;
    document.getElementById("avgResponseTime").textContent = `${apiStatsData.summary.avgResponseTime || 0}ms`;
    
    const errorRate = apiStatsData.summary.errorRate || 0;
    const successRate = (100 - parseFloat(errorRate)).toFixed(2);
    document.getElementById("successRate").textContent = `${successRate}%`;
  }

  // Update today's API stats
  if (apiStatsData.dailyData && apiStatsData.dailyData.length > 0) {
    const today = apiStatsData.dailyData[apiStatsData.dailyData.length - 1];
    
    document.getElementById("todayRequests").textContent = today.totalRequests?.toLocaleString() || 0;
    document.getElementById("todayErrors").textContent = (today.errors?.total || 0).toLocaleString();
    document.getElementById("todayAvgLatency").textContent = `${today.performance?.avg || 0}ms`;
    document.getElementById("todaySuccessRate").textContent = `${today.successRate || 0}%`;
  }

  // Populate top routes table
  if (apiStatsData.summary && apiStatsData.summary.topRoutes && apiStatsData.summary.topRoutes.length > 0) {
    const topRoutesTable = document.getElementById("topRoutesTable");
    topRoutesTable.innerHTML = '';
    
    apiStatsData.summary.topRoutes.forEach((route, index) => {
      const row = document.createElement('tr');
      
      const methodBadgeClass = {
        'GET': 'badge bg-primary',
        'POST': 'badge bg-success',
        'PUT': 'badge bg-warning',
        'PATCH': 'badge bg-info',
        'DELETE': 'badge bg-danger'
      }[route.method] || 'badge bg-secondary';
      
      row.innerHTML = `
        <td>${index + 1}</td>
        <td><span class="${methodBadgeClass}">${route.method}</span></td>
        <td><code>${route.path}</code></td>
        <td>${route.count?.toLocaleString() || 0}</td>
        <td>${route.avgLatency?.toFixed(2) || 0}ms</td>
      `;
      topRoutesTable.appendChild(row);
    });
  }

  // Prepare API statistics chart data
  const apiLabels = [];
  const requestsChartData = [];
  const avgLatencyData = [];
  const p95LatencyData = [];
  const errorRateData = [];

  if (apiStatsData.dailyData && apiStatsData.dailyData.length > 0) {
    apiStatsData.dailyData.forEach(day => {
      apiLabels.push(formatDate(day.date));
      requestsChartData.push(day.totalRequests || 0);
      avgLatencyData.push(day.performance?.avg || 0);
      p95LatencyData.push(day.performance?.p95 || 0);
      
      const totalErrors = day.errors?.total || 0;
      const totalRequests = day.totalRequests || 1;
      const errorRate = (totalErrors / totalRequests * 100).toFixed(2);
      errorRateData.push(parseFloat(errorRate));
    });

    // Create Requests Volume Chart
    const requestsCtx = document.getElementById('requestsChart');
    new Chart(requestsCtx, {
      type: 'bar',
      data: {
        labels: apiLabels,
        datasets: [
          {
            label: 'Total Requests',
            data: requestsChartData,
            backgroundColor: 'rgba(0, 102, 255, 0.6)',
            borderColor: 'rgb(0, 102, 255)',
            borderWidth: 1
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            title: {
              display: true,
              text: 'Requests'
            }
          }
        }
      }
    });

    // Create Response Time Chart
    const latencyCtx = document.getElementById('latencyChart');
    new Chart(latencyCtx, {
      type: 'line',
      data: {
        labels: apiLabels,
        datasets: [
          {
            label: 'Avg Latency',
            data: avgLatencyData,
            borderColor: 'rgb(255, 159, 64)',
            backgroundColor: 'rgba(255, 159, 64, 0.1)',
            borderWidth: 2,
            tension: 0.4,
            fill: true
          },
          {
            label: 'P95 Latency',
            data: p95LatencyData,
            borderColor: 'rgb(255, 99, 132)',
            backgroundColor: 'rgba(255, 99, 132, 0.1)',
            borderWidth: 2,
            tension: 0.4,
            fill: false,
            borderDash: [5, 5]
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            position: 'top'
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            title: {
              display: true,
              text: 'Latency (ms)'
            }
          }
        }
      }
    });
  }
});
</script>
