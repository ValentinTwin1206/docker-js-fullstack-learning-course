{{!< layout}}
{{> _navbar isProfile=true}}

<div class="container mt-4">
  <div class="d-flex flex-wrap justify-content-center gap-4">

    <!-- LEFT SIDE: User Info + API Keys -->
    <div class="card shadow-sm p-3" style="flex: 0 0 380px;">
      <div class="text-center">
        <h4 class="mb-1">{{username}}</h4>
        <p class="mb-3">{{firstname}} {{lastname}}</p>
      </div>

      <!-- API Keys Section -->
      <div id="apiKeySection" class="mt-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="mb-0">API Keys</h6>
          <button id="createApiKeyBtn" class="btn btn-secondary btn-sm">Generate new key</button>
        </div>
        
        {{#if hasApiKey}}
          <div class="list-group mb-3">
            {{#each apiKeys}}
              <div class="list-group-item d-flex justify-content-between align-items-center" data-token-name="{{tokenName}}">
                <div class="flex-grow-1">
                  <strong>{{tokenName}}</strong> - <small class="expiration-date" data-expires="{{expiresAt}}"></small>
                </div>
                <button class="btn btn-sm btn-outline-danger delete-api-key-btn" data-token-name="{{tokenName}}" type="button">
                  &times;
                </button>
              </div>
            {{/each}}
          </div>
        {{/if}}
      </div>
    </div>

    <!-- RIGHT SIDE: Profile Form -->
    <div class="card shadow-sm p-4 flex-grow-1" style="min-width:300px; max-width:600px;">
      <form id="profileForm">
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" class="form-control" id="username" name="username" value="{{username}}" required disabled>
        </div>

        <div class="mb-3">
          <label for="firstname" class="form-label">Firstname</label>
          <input type="text" class="form-control" id="firstname" name="firstname" value="{{firstname}}" required>
        </div>

        <div class="mb-3">
          <label for="lastname" class="form-label">Lastname</label>
          <input type="text" class="form-control" id="lastname" name="lastname" value="{{lastname}}" required>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" name="email" value="{{email}}" required>
        </div>

        <div class="d-flex gap-2">
          <button type="button" id="cancelBtn" class="btn btn-sm btn-lightgray flex-grow-1">Cancel</button>
          <button type="submit" class="btn btn-primary flex-grow-1">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const profileForm = document.getElementById("profileForm");
  const cancelBtn   = document.getElementById("cancelBtn");

  const toastEl = document.getElementById("profileToast");
  const toast   = new bootstrap.Toast(toastEl, { delay: 2000 });

  // Format expiration dates for all API keys
  const now = new Date();
  document.querySelectorAll('.expiration-date').forEach(el => {
    const expiresAt = new Date(el.dataset.expires);
    if (!isNaN(expiresAt.getTime())) {
      const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
      const formattedDate = `Expires on ${expiresAt.toLocaleDateString('en-US', options)}`;
      el.textContent = formattedDate;
      
      // Make it red if expired
      if (expiresAt < now) {
        el.classList.add('text-danger');
        el.classList.remove('text-muted');
      }
    }
  });

  profileForm.addEventListener("submit", async event => {
    event.preventDefault();

    const username  = "{{username}}";
    const firstname = document.getElementById("firstname").value.trim();
    const lastname  = document.getElementById("lastname").value.trim();
    const email     = document.getElementById("email").value.trim();

    await apiRequest(`/api/v1/users/${username}`, "PATCH", { firstname, lastname, email });

  });

  cancelBtn.addEventListener("click", () => window.location.reload());

  // --- API Key logic ---
  const createBtn = document.getElementById("createApiKeyBtn");
  
  // Delete API key buttons
  document.querySelectorAll('.delete-api-key-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const tokenName = e.target.dataset.tokenName;
      const username = "{{username}}";
      
      if (confirm(`Are you sure you want to revoke the API key "${tokenName}"?`)) {
        await apiRequest(`/api/v1/apikeys/${username}/${tokenName}`, "DELETE", {});
      }
    });
  });

  if (createBtn) {
    createBtn.addEventListener("click", () => {
      // Show modal to get API key name
      const inputModalHTML = `
        <div class="modal fade" id="apiKeyNameModal" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Create New API Key</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <label for="modalTokenNameInput" class="form-label">API Key Name</label>
                <input type="text" class="form-control" id="modalTokenNameInput" placeholder="e.g., Production Server" required>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmCreateApiKey">Create</button>
              </div>
            </div>
          </div>
        </div>
      `;
      
      document.body.insertAdjacentHTML('beforeend', inputModalHTML);
      const inputModal = new bootstrap.Modal(document.getElementById('apiKeyNameModal'));
      inputModal.show();
      
      document.getElementById('confirmCreateApiKey').addEventListener('click', async () => {
        const username = "{{username}}";
        const tokenName = document.getElementById("modalTokenNameInput")?.value.trim();
        
        if (!tokenName) {
          alert('Please provide a name for the API key');
          return;
        }
        
        inputModal.hide();
        
        const result = await apiRequest("/api/v1/apikeys", "POST", { username, tokenName }, "application/json", true);
      
      if (result.ok && result.data?.token) {
        // Show token in a modal - ONLY ONCE
        const token = result.data.token;
        const modalHTML = `
          <div class="modal fade" id="apiKeyModal" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header bg-warning">
                  <h5 class="modal-title">API Key generated</h5>
                </div>
                <div class="modal-body">
                  <div class="input-group mb-3">
                    <input type="text" class="form-control" id="newApiKeyInput" value="${token}" readonly>
                    <button class="btn btn-outline-secondary" type="button" id="copyNewApiKeyBtn">Copy</button>
                  </div>
                  <small class="text-muted">Make sure to copy your API key now. You won't be able to see it again!</small>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
              </div>
            </div>
          </div>
        `;
        
        document.body.insertAdjacentHTML('beforeend', modalHTML);
        const modal = new bootstrap.Modal(document.getElementById('apiKeyModal'));
        
        document.getElementById('copyNewApiKeyBtn').addEventListener('click', () => {
          navigator.clipboard.writeText(token);
          showToast('API key copied to clipboard!', 200, true);
        });
        
        modal.show();
        
        // Reload page when modal is closed
        document.getElementById('apiKeyModal').addEventListener('hidden.bs.modal', () => {
          window.location.reload();
        });
      }
      });
      
      // Clean up input modal when hidden
      document.getElementById('apiKeyNameModal').addEventListener('hidden.bs.modal', function() {
        this.remove();
      });
    });
  }
});
</script>
